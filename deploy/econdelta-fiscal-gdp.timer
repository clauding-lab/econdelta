[Unit]
Description=Run EconDelta fiscal revenue/GDP scraper weekly (Sun 19:39 UTC / Mon 01:39 BDT). IMF DataMapper + World Bank figures update at most annually; weekly is ample.
Requires=econdelta-fiscal-gdp.service

[Timer]
OnCalendar=Sun *-*-* 19:39:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
