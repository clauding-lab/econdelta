[Unit]
Description=EconDelta parse retry — fires daily at 20:35 UTC (02:35 BDT) so a flaked claude at the 02:10 primary fire gets a second chance before aggregate builds latest.json
Requires=econdelta-parse.service

[Timer]
OnCalendar=*-*-* 20:35:00 UTC
Unit=econdelta-parse.service
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
