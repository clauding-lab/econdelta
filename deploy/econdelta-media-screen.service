[Unit]
Description=EconDelta — daily media screen (BB indicator detection + Discord ping)
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# Retry on transient failures (LLM API / press-site brief outages).
# Up to 3 starts per window — initial fire plus 2 retries.
# systemd only trips the limiter on the (burst+1)-th start, which lands
# burst * cycle after the first — not one cycle. Window sized to
# StartLimitBurst(3) * (TimeoutStartSec(1800)+RestartSec(300)) = 6300,
# plus margin for the untimed SIGTERM/SIGKILL stop phase between retries.
StartLimitIntervalSec=6900
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=. The file is world-readable
# (0644) either way; the break is the WRITE side — nightly logrotate's
# `su adnan-local adnan-local` + copytruncate opens O_RDWR to truncate,
# which a non-root adnan-local can't do to a root-owned file. '+' runs
# outside this unit's own sandboxing so the chown always succeeds no
# matter who most recently (re)created the file; the leading
# `[ -L ... ] && exit 1` refuses (aborts the whole start) instead of
# chowning/chmoding through a symlink if the path is ever swapped for
# one (CWE-59). chmod 0644 here is deliberately this guard's mode
# authority for the log file, not just a touch side effect.
ExecStartPre=+/bin/sh -c '[ -L /home/adnan-local/econdelta/logs/media_screen-systemd.log ] && exit 1; touch /home/adnan-local/econdelta/logs/media_screen-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/media_screen-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/media_screen-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m scrapers.media_screen

# Resource limits to protect Notifyr and Mission Control on the same VPS
MemoryMax=500M
MemoryHigh=400M
CPUQuota=50%
TasksMax=512

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs

# LLM extraction per article adds latency. extract.py calls run_max at
# effort='high', which on the pinned box CLI maps to a high-effort Opus call —
# worst-case Opus latency under Max load can reach ~180s/call. ~5 articles ×
# (HTTP fetch + LLM call) can exceed 600s, so 600s risks a systemd kill mid-run
# after a partial insert. 1800s mirrors the briefing service's generous LLM
# headroom (StartLimitIntervalSec above is sized independently — see the
# [Unit] block comment — to fit 3 retry cycles, not to match this value).
TimeoutStartSec=1800
Restart=on-failure
RestartSec=300

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan-local/econdelta/logs/media_screen-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/media_screen-systemd.log
SyslogIdentifier=econdelta-media-screen

[Install]
WantedBy=multi-user.target
