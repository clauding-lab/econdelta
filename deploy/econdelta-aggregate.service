[Unit]
Description=EconDelta — Aggregate latest data across scrapers
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# Retry on transient failures (rare for aggregator, but cheap insurance).
# Up to 3 starts per window — initial fire plus 2 retries. systemd only
# trips the limiter on the (burst+1)-th start, which lands burst * cycle
# after the first — not one cycle. Window sized to StartLimitBurst(3) *
# (TimeoutStartSec(600)+RestartSec(300)) = 2700, plus margin for the
# untimed SIGTERM/SIGKILL stop phase between retries. See AGENTS.md
# landmine #6 for the "Start request repeated too quickly" behavior this
# window exists to actually produce.
StartLimitIntervalSec=3300
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=, and nightly logrotate's
# `su adnan-local adnan-local` then can't open a root-owned file.
# '+' runs outside this unit's own sandboxing so the chown always
# succeeds no matter who most recently (re)created the file.
ExecStartPre=+/bin/sh -c 'touch /home/adnan-local/econdelta/logs/aggregate-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/aggregate-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/aggregate-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m aggregate_latest

# Resource limits — aggregator is light
MemoryMax=250M
MemoryHigh=200M
CPUQuota=50%
TasksMax=512

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs

# Timeouts + retry on transient failures
TimeoutStartSec=600
Restart=on-failure
RestartSec=300

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan-local/econdelta/logs/aggregate-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/aggregate-systemd.log
SyslogIdentifier=econdelta-aggregate

[Install]
WantedBy=multi-user.target
