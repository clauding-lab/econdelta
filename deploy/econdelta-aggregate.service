[Unit]
Description=EconDelta — Aggregate latest data across scrapers
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# Retry on transient failures (rare for aggregator, but cheap insurance).
# Up to 3 starts per window — initial fire plus 2 retries. systemd only
# trips the limiter on the (burst+1)-th start, which lands burst * cycle
# after the first — not one cycle. Window sized to StartLimitBurst(3) *
# (TimeoutStartSec(600)+RestartSec(300)) = 2700, plus margin for the
# untimed SIGTERM/SIGKILL stop phase between retries. See AGENTS.md
# landmine #6 for the "Start request repeated too quickly" behavior this
# window exists to actually produce.
StartLimitIntervalSec=3300
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=. The file is world-readable
# (0644) either way; the break is the WRITE side — nightly logrotate's
# `su adnan-local adnan-local` + copytruncate opens O_RDWR to truncate,
# which a non-root adnan-local can't do to a root-owned file. '+' runs
# outside this unit's own sandboxing so the chown always succeeds no
# matter who most recently (re)created the file; the leading
# `[ -L ... ] && exit 1` refuses (aborts the whole start) instead of
# chowning/chmoding through a symlink if the path is ever swapped for
# one (CWE-59). chmod 0644 here is deliberately this guard's mode
# authority for the log file, not just a touch side effect.
ExecStartPre=+/bin/sh -c '[ -L /home/adnan-local/econdelta/logs/aggregate-systemd.log ] && exit 1; touch /home/adnan-local/econdelta/logs/aggregate-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/aggregate-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/aggregate-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m aggregate_latest

# Resource limits — sized for the aggregator's own Chromium launch
# (aggregate_latest._fetch_remittance_html -> fetchers.html_fetcher.fetch_html,
# 2026-08-08 frozen-charts fix). The prior 250M/200M/50% sizing assumed a pure
# HTTP+Supabase workload and predates this unit hosting a headless-Chromium
# fetch; other units that already launch Playwright (econdelta-forex.service,
# econdelta-dse.service, econdelta-commodity.service: 500M/400M/50%;
# econdelta-fetch.service/econdelta-parse.service: 1500M/1200M/200%) are all
# sized well above the old aggregate numbers. 800M/600M/100% gives headroom
# above the forex/dse/commodity tier (a single Chromium instance, not the
# heavier multi-page fetch/parse workload) without matching the largest
# units. TasksMax=512 (unchanged) already comfortably covers a Chromium
# launch's process/thread count -- every Playwright-launching unit in this
# fleet shares the same 512 value.
MemoryMax=800M
MemoryHigh=600M
CPUQuota=100%
TasksMax=512

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs

# Timeouts + retry on transient failures
TimeoutStartSec=600
Restart=on-failure
RestartSec=300

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan-local/econdelta/logs/aggregate-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/aggregate-systemd.log
SyslogIdentifier=econdelta-aggregate

[Install]
WantedBy=multi-user.target
