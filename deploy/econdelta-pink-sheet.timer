[Unit]
Description=Run EconDelta World Bank Pink Sheet scraper daily at 19:27 UTC (01:27 BDT next day). Source updates monthly; the daily idempotent fire self-heals a missed month (upsert on (metric_id, as_of) stamps the latest reporting month).
Requires=econdelta-pink-sheet.service

[Timer]
OnCalendar=*-*-* 19:27:00 UTC
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
