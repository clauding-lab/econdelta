[Unit]
Description=EconDelta — Bangladesh Bank forex + reserves scraper
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# Retry on transient failures (e.g. BB.org.bd 45s timeout under bank-opening
# load). Allow up to 3 starts per 30-min window — the initial fire plus 2
# retries. Beyond that, give up until the next scheduled fire.
# systemd only trips the limiter on the (burst+1)-th start, which lands
# burst * cycle after the first — not one cycle. StartLimitBurst(3) *
# (TimeoutStartSec(300)+RestartSec(300)) = 1800 sat exactly on the old
# window with no margin for the untimed SIGTERM/SIGKILL stop phase between
# retries, so a unit failing every attempt never tripped the limiter.
StartLimitIntervalSec=2700
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=, and nightly logrotate's
# `su adnan-local adnan-local` then can't open a root-owned file.
# '+' runs outside this unit's own sandboxing so the chown always
# succeeds no matter who most recently (re)created the file.
ExecStartPre=+/bin/sh -c 'touch /home/adnan-local/econdelta/logs/bb_forex-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/bb_forex-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/bb_forex-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m scrapers.bb_forex

# Resource limits to protect Notifyr and Mission Control on the same VPS
MemoryMax=500M
MemoryHigh=400M
CPUQuota=50%
TasksMax=512

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs

# Timeouts + retry on transient failures
TimeoutStartSec=300
# exit 2 = anomaly hold (rate anomaly: write skipped; reserves same-month
# revision or month regression: snapshot written but the previous reserves
# value held) — not a transient failure. A restart would hit BB again and
# reach the identical verdict, wasting a Playwright fetch against BB's
# CAPTCHA wall and duplicating the Discord alert. Retry only genuine
# failures (exit 1: fetch/parse/validation).
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=300

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan-local/econdelta/logs/bb_forex-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/bb_forex-systemd.log
SyslogIdentifier=econdelta-forex

[Install]
WantedBy=multi-user.target
