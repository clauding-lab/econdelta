[Unit]
Description=EconDelta — FSR sector-wise NPL extractor (bb_npl_structure)
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# systemd only trips the limiter on the (burst+1)-th start, which lands
# burst * cycle after the first — not one cycle. Window sized to
# StartLimitBurst(3) * (TimeoutStartSec(2700)+RestartSec(300)) = 9000,
# plus margin for the untimed SIGTERM/SIGKILL stop phase between retries.
StartLimitIntervalSec=9600
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=. The file is world-readable
# (0644) either way; the break is the WRITE side — nightly logrotate's
# `su adnan-local adnan-local` + copytruncate opens O_RDWR to truncate,
# which a non-root adnan-local can't do to a root-owned file. '+' runs
# outside this unit's own sandboxing so the chown always succeeds no
# matter who most recently (re)created the file; the leading
# `[ -L ... ] && exit 1` refuses (aborts the whole start) instead of
# chowning/chmoding through a symlink if the path is ever swapped for
# one (CWE-59). chmod 0644 here is deliberately this guard's mode
# authority for the log file, not just a touch side effect.
ExecStartPre=+/bin/sh -c '[ -L /home/adnan-local/econdelta/logs/bb_npl_structure-systemd.log ] && exit 1; touch /home/adnan-local/econdelta/logs/bb_npl_structure-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/bb_npl_structure-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/bb_npl_structure-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m scrapers.bb_npl_structure

MemoryMax=1500M
MemoryHigh=1200M
CPUQuota=50%
TasksMax=512

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs /home/adnan-local/.claude

TimeoutStartSec=2700
# exit 3 = "already captured for this FSR position date — skip" (a by-design
# no-op, see scrapers/bb_npl_structure.py main() and
# utils/supabase_writer._STATUS_BY_EXIT, which maps it to run_logs status
# 'skip'), not a failure. SuccessExitStatus=3 makes systemd treat it as a
# CLEAN exit — the unit ends 'inactive', not 'failed', so it does not show
# in `systemctl --failed` and Restart=on-failure never fires for it (a
# restart would just re-run the ~50s extraction attempt and reach the exact
# same skip). NOTE: RestartPreventExitStatus= only suppresses the retry —
# it does NOT change whether the unit is reported as failed, so it would
# not fix the `systemctl --failed` pollution this exists to prevent; see
# AGENTS.md landmine 48. Retry only genuine failures (exit 1 / exit 2, both
# unaffected by this line).
SuccessExitStatus=3
Restart=on-failure
RestartSec=300

StandardOutput=append:/home/adnan-local/econdelta/logs/bb_npl_structure-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/bb_npl_structure-systemd.log
SyslogIdentifier=econdelta-npl-structure

[Install]
WantedBy=multi-user.target
