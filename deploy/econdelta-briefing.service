[Unit]
Description=EconDelta — Weekly ALCO briefing (Opus 4.8 1M, xhigh)
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target
# systemd only trips the limiter on the (burst+1)-th start, which lands
# burst * cycle after the first — not one cycle. Minimum here is exactly
# StartLimitBurst(2) * (TimeoutStartSec(3600)+RestartSec(600)) = 8400, which
# is on the boundary (systemd resets only when elapsed > interval — no
# margin against the untimed SIGTERM/SIGKILL stop phase between retries).
StartLimitIntervalSec=9000
StartLimitBurst=2

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
Environment="CLAUDE_BINARY=/usr/bin/claude"
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=. The file is world-readable
# (0644) either way; the break is the WRITE side — nightly logrotate's
# `su adnan-local adnan-local` + copytruncate opens O_RDWR to truncate,
# which a non-root adnan-local can't do to a root-owned file. '+' runs
# outside this unit's own sandboxing so the chown always succeeds no
# matter who most recently (re)created the file; the leading
# `[ -L ... ] && exit 1` refuses (aborts the whole start) instead of
# chowning/chmoding through a symlink if the path is ever swapped for
# one (CWE-59). chmod 0644 here is deliberately this guard's mode
# authority for the log file, not just a touch side effect.
ExecStartPre=+/bin/sh -c '[ -L /home/adnan-local/econdelta/logs/briefing-systemd.log ] && exit 1; touch /home/adnan-local/econdelta/logs/briefing-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/briefing-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/briefing-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m briefing

MemoryMax=1500M
MemoryHigh=1200M
CPUQuota=200%
TasksMax=512

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs /home/adnan-local/.claude

TimeoutStartSec=3600
# exit 2 = data stale (gate skip), not a transient failure — don't retry/re-alert.
# Retry only genuine failures (exit 1: Claude/validation/network).
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=600

StandardOutput=append:/home/adnan-local/econdelta/logs/briefing-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/briefing-systemd.log
SyslogIdentifier=econdelta-briefing

[Install]
WantedBy=multi-user.target
