[Unit]
Description=EconDelta — BB primary-auction results + 12-week calendar scraper
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# Retry on transient failures (BB CAPTCHA/render hiccups). Up to 3 starts per
# window — initial fire plus 2 retries. systemd only trips the limiter on
# the (burst+1)-th start, which lands burst * cycle after the first — not
# one cycle. Window sized to StartLimitBurst(3) *
# (TimeoutStartSec(900)+RestartSec(300)) = 3600, plus margin for the
# untimed SIGTERM/SIGKILL stop phase between retries.
StartLimitIntervalSec=4200
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=. The file is world-readable
# (0644) either way; the break is the WRITE side — nightly logrotate's
# `su adnan-local adnan-local` + copytruncate opens O_RDWR to truncate,
# which a non-root adnan-local can't do to a root-owned file. '+' runs
# outside this unit's own sandboxing so the chown always succeeds no
# matter who most recently (re)created the file; the leading
# `[ -L ... ] && exit 1` refuses (aborts the whole start) instead of
# chowning/chmoding through a symlink if the path is ever swapped for
# one (CWE-59). chmod 0644 here is deliberately this guard's mode
# authority for the log file, not just a touch side effect.
ExecStartPre=+/bin/sh -c '[ -L /home/adnan-local/econdelta/logs/bb_auction-systemd.log ] && exit 1; touch /home/adnan-local/econdelta/logs/bb_auction-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/bb_auction-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/bb_auction-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m scrapers.bb_auction

# Resource limits. Sized between forex (Playwright/Chromium ~500M) and parse
# (claude CLI run_max ~1500M): bb_auction does BOTH — it renders the BB listing +
# calendar through the Playwright + claude-haiku CAPTCHA solver, and falls back to
# run_max for LLM row extraction. VPS-TUNE if Chromium+claude overshoot.
MemoryMax=1200M
MemoryHigh=1000M
CPUQuota=150%
TasksMax=512

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# bb_auction calls the claude CLI (haiku CAPTCHA solver + run_max), which writes
# under ~/.claude/ each run; the sibling ~/.claude.json is added by the drop-in.
# Both are needed under ProtectHome=read-only — same complete carve-out as
# parse/briefing (AGENT_LEARNINGS 2026-05-29).
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs /home/adnan-local/.claude

# Timeouts + retry on transient failures. Generous: two solver-gated pages (up to
# 3 CAPTCHA attempts each) plus a possible run_max LLM extraction fallback.
TimeoutStartSec=900
Restart=on-failure
RestartSec=300

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan-local/econdelta/logs/bb_auction-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/bb_auction-systemd.log
SyslogIdentifier=econdelta-auction

[Install]
WantedBy=multi-user.target
