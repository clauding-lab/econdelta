[Unit]
Description=Run EconDelta aggregator daily at 20:55 UTC (02:55 BDT next day) — runs after parse (02:10 + 02:35) so today's parse output lands in latest.json same-day, and ~5 h before The Brief's 08:00 BDT publish reads it
Requires=econdelta-aggregate.service

[Timer]
OnCalendar=*-*-* 20:55:00 UTC
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
