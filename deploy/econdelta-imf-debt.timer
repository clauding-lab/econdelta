[Unit]
Description=Run EconDelta IMF DataMapper debt/GDP scraper weekly (Sun 19:36 UTC / Mon 01:36 BDT). DataMapper figures update at most annually; weekly is ample.
Requires=econdelta-imf-debt.service

[Timer]
OnCalendar=Sun *-*-* 19:36:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
