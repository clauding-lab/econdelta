[Unit]
Description=EconDelta — IMF EFF outstanding (SDR mn) scraper
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target

# Retry on transient failures (network blips). Up to 3 starts per 30-min window
# — initial fire plus 2 retries.
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=, and nightly logrotate's
# `su adnan-local adnan-local` then can't open a root-owned file.
# '+' runs outside this unit's own sandboxing so the chown always
# succeeds no matter who most recently (re)created the file.
ExecStartPre=+/bin/sh -c 'touch /home/adnan-local/econdelta/logs/imf_eff-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/imf_eff-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/imf_eff-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m scrapers.imf_eff

# Resource limits to protect Notifyr and Mission Control on the same VPS
MemoryMax=500M
MemoryHigh=400M
CPUQuota=50%
TasksMax=512

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/data /home/adnan-local/econdelta/logs

# Timeouts + retry on transient failures
TimeoutStartSec=120
Restart=on-failure
RestartSec=300

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan-local/econdelta/logs/imf_eff-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/imf_eff-systemd.log
SyslogIdentifier=econdelta-imf-eff

[Install]
WantedBy=multi-user.target
