[Unit]
Description=EconDelta — Freshness sentinel (daily data-staleness digest + dead-man's-switch)
Documentation=https://github.com/clauding-lab/econdelta
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=adnan-local
Group=adnan-local
WorkingDirectory=/home/adnan-local/econdelta
EnvironmentFile=/etc/econdelta.env
# Log-file ownership guard (deploy/README.md Troubleshooting,
# AGENT_LEARNINGS.md 2026-08-05): if this log is absent, systemd
# creates the StandardOutput/StandardError append target as root
# before ExecStart drops to User=/Group=. The file is world-readable
# (0644) either way; the break is the WRITE side — nightly logrotate's
# `su adnan-local adnan-local` + copytruncate opens O_RDWR to truncate,
# which a non-root adnan-local can't do to a root-owned file. '+' runs
# outside this unit's own sandboxing so the chown always succeeds no
# matter who most recently (re)created the file; the leading
# `[ -L ... ] && exit 1` refuses (aborts the whole start) instead of
# chowning/chmoding through a symlink if the path is ever swapped for
# one (CWE-59). chmod 0644 here is deliberately this guard's mode
# authority for the log file, not just a touch side effect.
ExecStartPre=+/bin/sh -c '[ -L /home/adnan-local/econdelta/logs/sentinel-systemd.log ] && exit 1; touch /home/adnan-local/econdelta/logs/sentinel-systemd.log && chmod 0644 /home/adnan-local/econdelta/logs/sentinel-systemd.log && chown adnan-local:adnan-local /home/adnan-local/econdelta/logs/sentinel-systemd.log'
ExecStart=/home/adnan-local/econdelta/.venv/bin/python -m sentinel

MemoryMax=400M
MemoryHigh=300M
TasksMax=256

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan-local/econdelta/logs

TimeoutStartSec=600
# Read failure (exit 1) is transient (Supabase blip) — retry via StartLimitBurst.
# A staleness digest is a clean run (exit 0) and never retries.
Restart=on-failure
RestartSec=120

StandardOutput=append:/home/adnan-local/econdelta/logs/sentinel-systemd.log
StandardError=append:/home/adnan-local/econdelta/logs/sentinel-systemd.log
SyslogIdentifier=econdelta-sentinel

[Install]
WantedBy=multi-user.target
