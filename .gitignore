__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.env

# Data and log snapshots — keep only .gitkeep sentinels
data/*/
logs/*/
logs/*.log
logs/*.stderr
logs/*.stdout
# Rotated systemd logs (logrotate on ExonVPS) — e.g.
# logs/econdelta-forex-systemd.log.1, logs/econdelta-forex-systemd.log.1.gz
logs/*.log.*
data/latest.json
# Ad-hoc backup snapshots left on the box during manual tuning — e.g.
# data/latest.json.pre-tuning.bak
data/*.bak
# Per-box runtime state for the stillness alarm — learned by observation on the
# box that runs the aggregate; committing one box's copy would seed another with
# counters it never observed (AGENTS.md landmine 40).
data/staleness_state.json
# Same landmine-40 reasoning for the media-screen zero-insert streak counter
# (media_screen/streak.py) — per-box runtime state, not a data artifact.
# `data/*/` above only matches directories, so this file (a direct child of
# data/) needs its own line, plus its atomic-write temp file.
data/media_screen_zero_insert_streak.json
*.json.tmp
!data/.gitkeep
!logs/.gitkeep
!data/*/.gitkeep
!logs/*/.gitkeep

# Graphify outputs
.graphifyignore
graphify-out/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Git worktrees
.worktrees/
