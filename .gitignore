__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.env

# Data and log snapshots — keep only .gitkeep sentinels
data/*/
logs/*/
logs/*.log
logs/*.stderr
logs/*.stdout
data/latest.json
# Per-box runtime state for the stillness alarm — learned by observation on the
# box that runs the aggregate; committing one box's copy would seed another with
# counters it never observed (AGENTS.md landmine 40).
data/staleness_state.json
!data/.gitkeep
!logs/.gitkeep
!data/*/.gitkeep
!logs/*/.gitkeep

# Graphify outputs
.graphifyignore
graphify-out/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Git worktrees
.worktrees/
