# Discord webhook for alerts — create a dedicated #econdelta-alerts channel
DISCORD_WEBHOOK_URL=
# Discord webhook for the #thebrief channel — the media screen posts its daily
# report here (Copotron watches #thebrief for `approve <id>` / `reject <id>`).
MEDIA_SCREEN_WEBHOOK_URL=

# Root of the econdelta deployment (used by systemd units on VPS)
ECONDELTA_HOME=/home/adnan/econdelta

# Dry-run mode: if "1", notifier prints instead of posting to Discord
ECONDELTA_DRY_RUN=0

# Provenance stamping: if "1", upsert_metric_history() sends its provenance=
# value to Supabase. Leave at 0 until migration 0013 is applied — flipping it
# early 400s every provenance-stamped write (AGENTS.md landmine 43).
ECONDELTA_PROVENANCE_ENABLED=0
